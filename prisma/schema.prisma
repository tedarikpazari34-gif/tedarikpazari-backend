generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CompanyStatus {
  PENDING
  APPROVED
  BLOCKED
}

enum RFQStatus {
  OPEN
  CLOSED
}

enum QuoteStatus {
  SENT
  ACCEPTED
  REJECTED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PREPARING
  SHIPPED
  COMPLETED
  CANCELLED
}

enum PayoutStatus {
  PENDING
  PAID
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DisputeStatus {
  OPEN
  SELLER_RESPONDED
  RESOLVED_BUYER
  RESOLVED_SELLER
  REJECTED
}

enum DisputeResolution {
  RELEASE_TO_SELLER
  REFUND_TO_BUYER
  PARTIAL_REFUND
}

enum LedgerType {
  ESCROW_DEPOSIT
  ESCROW_RELEASE_SELLER
  ESCROW_REFUND_BUYER
  COMMISSION
  PAYOUT_REQUEST
  PAYOUT_APPROVE
  PAYOUT_REJECT
  ADJUSTMENT
}

enum EscrowEventType {
  RELEASE_TO_SELLER
  REFUND_TO_BUYER
  PARTIAL_REFUND
}

enum PaymentProvider {
  IYZICO
  PAYPAL
}

enum PaymentStatus {
  INITIATED
  CALLBACK_RECEIVED
  SUCCESS
  FAILED
}

enum Role {
  ADMIN
  BUYER
  SELLER
  LOGISTICS
}

enum NotificationType {
  RFQ
  QUOTE
  ORDER
  PAYMENT
  PAYOUT
  COMPANY
  SYSTEM
}

enum ChatThreadType {
  RFQ
  ORDER
  SHIPPING
}

enum PayoutRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ShippingOrderStatus {
  PENDING_PICKUP
  PICKED_UP
  IN_TRANSIT
  DELIVERED
}

model Company {
  id                   String        @id @default(cuid())
  name                 String
  taxNumber            String?
  verified             Boolean       @default(false)
  taxOffice            String?
  email                String?
  phone                String?
  address              Json?
  status               CompanyStatus @default(PENDING)
  role                 Role          @default(BUYER)
  iyzicoSubMerchantKey String?
  createdAt            DateTime      @default(now())

  logo           String?
  banner         String?
  description    String?
  website        String?
  city           String?
  country        String?
  responseTime   Int     @default(0)
  completedDeals Int     @default(0)
  rating         Float   @default(0)
  reviewCount    Int     @default(0)

  users                User[]
  products             Product[]
  rfqs                 RFQ[]
  quotes               Quote[]
  ordersBuy            Order[]               @relation("BuyerOrders")
  ordersSell           Order[]               @relation("SellerOrders")
  payouts              Payout[]
  verificationRequests VerificationRequest[]

  disputesBuyer  Dispute[] @relation("BuyerDisputes")
  disputesSeller Dispute[] @relation("SellerDisputes")

  ledgerFrom LedgerEntry[] @relation("LedgerFrom")
  ledgerTo   LedgerEntry[] @relation("LedgerTo")

  buyerReviews  Review[] @relation("BuyerReviews")
  sellerReviews Review[] @relation("SellerReviews")

  buyerChatThreads     ChatThread[] @relation("BuyerChatThreads")
  sellerChatThreads    ChatThread[] @relation("SellerChatThreads")
  logisticsChatThreads ChatThread[] @relation("LogisticsChatThreads")

  wallet              CompanyWallet?
  paymentTransactions PaymentTransaction[]
  shippingRFQs        ShippingRFQ[]
  shippingQuotes      ShippingQuote[]

  shippingOrdersAsBuyer     ShippingOrder[] @relation("ShippingOrderBuyer")
  shippingOrdersAsSeller    ShippingOrder[] @relation("ShippingOrderSeller")
  shippingOrdersAsLogistics ShippingOrder[] @relation("ShippingOrderLogistics")

  payoutRequests PayoutRequest[]
}

model CompanyWallet {
  id        String   @id @default(cuid())
  companyId String   @unique
  available Decimal  @default(0)
  locked    Decimal  @default(0)
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      Role     @default(BUYER)
  companyId String
  createdAt DateTime @default(now())

  chatMessages ChatMessage[]
  auditLogs    AuditLog[]

  company           Company            @relation(fields: [companyId], references: [id])
  notifications     Notification[]
  favorites         Favorite[]
  pushSubscriptions PushSubscription[]
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String?
  userAgent String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
}

model Category {
  id        String     @id @default(cuid())
  name      String
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  createdAt DateTime   @default(now())

  products Product[]

  @@index([parentId])
}

model Product {
  id         String  @id @default(cuid())
  sellerId   String
  categoryId String?

  title       String
  description String?
  imageUrl    String?

  unitType  String
  moq       Int
  basePrice Decimal

  leadTimeDays Int?
  stockType    String?
  vatRate      Int?

  rfqEnabled Boolean @default(true)

  isActive   Boolean @default(true)
  isApproved Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seller   Company   @relation(fields: [sellerId], references: [id])
  category Category? @relation(fields: [categoryId], references: [id])

  images    ProductImage[]
  rfqs      RFQ[]
  favorites Favorite[]

  @@index([sellerId])
  @@index([categoryId])
  @@index([isActive, isApproved])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  sortOrder Int      @default(0)
  isCover   Boolean  @default(false)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])

  @@index([productId])
}

model RFQ {
  id        String    @id @default(cuid())
  productId String
  buyerId   String
  quantity  Int
  note      String?
  status    RFQStatus @default(OPEN)
  createdAt DateTime  @default(now())

  product Product @relation(fields: [productId], references: [id])
  buyer   Company @relation(fields: [buyerId], references: [id])

  quotes Quote[]
  order  Order?

  chatThreads ChatThread[]

  @@index([productId])
  @@index([buyerId])
  @@index([status])
}

model Quote {
  id           String      @id @default(cuid())
  rfqId        String
  sellerId     String
  unitPrice    Decimal
  deliveryDays Int
  sellerNote   String?
  status       QuoteStatus @default(SENT)
  createdAt    DateTime    @default(now())

  rfq    RFQ     @relation(fields: [rfqId], references: [id])
  seller Company @relation(fields: [sellerId], references: [id])

  order Order?

  @@index([rfqId])
  @@index([sellerId])
  @@index([status])
}

model Order {
  id               String  @id @default(cuid())
  rfqId            String  @unique
  quoteId          String  @unique
  buyerId          String
  sellerId         String
  totalAmount      Decimal
  commissionAmount Decimal

  escrowAmount   Decimal   @default(0)
  escrowReleased Boolean   @default(false)
  releasedAt     DateTime?

  payoutAmount Decimal     @default(0)
  status       OrderStatus @default(PENDING_PAYMENT)
  createdAt    DateTime    @default(now())

  shippingTrackingNo String?
  shippingCompany    String?
  shippedAt          DateTime?

  iyzicoConversationId String?
  iyzicoCheckoutToken  String?
  iyzicoPaymentId      String?
  iyzicoPaidAt         DateTime?
  iyzicoRawResult      Json?

  paymentAttempts PaymentAttempt[] @relation("OrderPaymentAttempts")

  rfq    RFQ     @relation(fields: [rfqId], references: [id])
  quote  Quote   @relation(fields: [quoteId], references: [id])
  buyer  Company @relation("BuyerOrders", fields: [buyerId], references: [id])
  seller Company @relation("SellerOrders", fields: [sellerId], references: [id])

  payout              Payout?              @relation("OrderPayout")
  disputes            Dispute[]
  escrowEvent         EscrowEvent[]
  ledger              LedgerEntry[]
  paymentTransactions PaymentTransaction[]
  shippingRFQs        ShippingRFQ[]
  shippingOrders      ShippingOrder[]

  review Review? @relation("OrderReview")

  chatThreads ChatThread[]

  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
}

model PaymentAttempt {
  id       String          @id @default(cuid())
  orderId  String
  provider PaymentProvider
  status   PaymentStatus   @default(INITIATED)

  conversationId  String?
  checkoutToken   String?
  iyzicoPaymentId String?

  rawRequest  Json?
  rawResponse Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation("OrderPaymentAttempts", fields: [orderId], references: [id])

  @@index([orderId])
  @@index([conversationId])
  @@index([checkoutToken])
}

model Payout {
  id          String       @id @default(cuid())
  orderId     String       @unique
  sellerId    String
  amount      Decimal
  status      PayoutStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  processedAt DateTime?
  note        String?

  order  Order   @relation("OrderPayout", fields: [orderId], references: [id])
  seller Company @relation(fields: [sellerId], references: [id])

  @@index([sellerId])
  @@index([status])
}

model VerificationRequest {
  id           String             @id @default(cuid())
  companyId    String
  documentUrl  String
  documentType String?
  fileName     String?
  publicId     String?
  note         String?
  adminNote    String?
  status       VerificationStatus @default(PENDING)
  createdAt    DateTime           @default(now())
  reviewedAt   DateTime?

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([status])
}

model Dispute {
  id          String             @id @default(cuid())
  orderId     String
  buyerId     String
  sellerId    String
  reason      String
  description String?
  status      DisputeStatus      @default(OPEN)
  resolution  DisputeResolution?
  adminNote   String?
  createdAt   DateTime           @default(now())
  resolvedAt  DateTime?

  order  Order   @relation(fields: [orderId], references: [id])
  buyer  Company @relation("BuyerDisputes", fields: [buyerId], references: [id])
  seller Company @relation("SellerDisputes", fields: [sellerId], references: [id])

  escrowEvent   EscrowEvent?
  ledgerEntries LedgerEntry[]
  files         DisputeFile[]

  @@index([orderId])
  @@index([status])
}

model DisputeFile {
  id           String   @id @default(cuid())
  disputeId    String
  url          String
  fileName     String?
  fileType     String?
  uploadedById String?
  createdAt    DateTime @default(now())

  dispute Dispute @relation(fields: [disputeId], references: [id])

  @@index([disputeId])
  @@index([uploadedById])
}

model EscrowEvent {
  id        String          @id @default(cuid())
  orderId   String
  disputeId String          @unique
  type      EscrowEventType
  amount    Decimal
  note      String?
  createdAt DateTime        @default(now())

  dispute Dispute @relation(fields: [disputeId], references: [id])
  order   Order   @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

model LedgerEntry {
  id            String     @id @default(cuid())
  type          LedgerType
  orderId       String?
  disputeId     String?
  fromCompanyId String?
  toCompanyId   String?
  amount        Decimal
  currency      String     @default("TRY")
  note          String?
  meta          Json?
  createdAt     DateTime   @default(now())

  order   Order?   @relation(fields: [orderId], references: [id])
  dispute Dispute? @relation(fields: [disputeId], references: [id])

  fromCompany Company? @relation("LedgerFrom", fields: [fromCompanyId], references: [id])
  toCompany   Company? @relation("LedgerTo", fields: [toCompanyId], references: [id])

  @@index([type])
  @@index([orderId])
  @@index([disputeId])
}

model AuditLog {
  id             String   @id @default(cuid())
  requestId      String?
  actorId        String?
  actorRole      String?
  actorCompanyId String?
  action         String
  entity         String
  entityId       String?
  success        Boolean  @default(true)
  errorMessage   String?
  ip             String?
  userAgent      String?
  metadata       Json?
  createdAt      DateTime @default(now())
  user           User?    @relation(fields: [userId], references: [id])
  userId         String?

  @@index([createdAt])
  @@index([actorCompanyId])
  @@index([entity])
}

model ShippingRFQ {
  id      String @id @default(cuid())
  orderId String
  buyerId String

  // Eski kayıtlarla uyumluluk için tam rota metni
  fromAddress String
  toAddress   String

  fromCity        String?
  fromDistrict    String?
  fromOpenAddress String?

  toCity        String?
  toDistrict    String?
  toOpenAddress String?

  palletCount  Int?
  packageCount Int?

  weight Float?
  volume Float?

  vehicleType           String?
  loadingDate           DateTime?
  requestedDeliveryDate DateTime?
  deliveryExpectation   String?

  isFragile    Boolean @default(false)
  isDangerous  Boolean @default(false)
  coldChain    Boolean @default(false)
  stackable    Boolean @default(true)
  needForklift Boolean @default(false)
  needCrane    Boolean @default(false)

  photoUrl  String?
  note      String?
  status    String   @default("OPEN")
  createdAt DateTime @default(now())

  order         Order           @relation(fields: [orderId], references: [id])
  buyer         Company         @relation(fields: [buyerId], references: [id])
  quotes        ShippingQuote[]
  shippingOrder ShippingOrder?
}

model ShippingQuote {
  id           String   @id @default(cuid())
  rfqId        String
  companyId    String
  price        Float
  deliveryDays Int
  note         String?
  status       String   @default("SENT")
  createdAt    DateTime @default(now())

  rfq           ShippingRFQ    @relation(fields: [rfqId], references: [id])
  company       Company        @relation(fields: [companyId], references: [id])
  shippingOrder ShippingOrder?
}

model ShippingOrder {
  id String @id @default(cuid())

  shippingRfqId   String @unique
  shippingQuoteId String @unique

  buyerId     String
  sellerId    String
  logisticsId String
  orderId     String

  status ShippingOrderStatus @default(PENDING_PICKUP)

  pickedUpAt  DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?

  trackingNo      String?
  shippingCompany String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shippingRfq   ShippingRFQ   @relation(fields: [shippingRfqId], references: [id])
  shippingQuote ShippingQuote @relation(fields: [shippingQuoteId], references: [id])
  order         Order         @relation(fields: [orderId], references: [id])

  buyer     Company @relation("ShippingOrderBuyer", fields: [buyerId], references: [id])
  seller    Company @relation("ShippingOrderSeller", fields: [sellerId], references: [id])
  logistics Company @relation("ShippingOrderLogistics", fields: [logisticsId], references: [id])

  chatThread ChatThread?

  @@index([buyerId])
  @@index([sellerId])
  @@index([logisticsId])
  @@index([orderId])
  @@index([status])
}

model PaymentTransaction {
  id                   String   @id @default(cuid())
  orderId              String
  sellerId             String
  paymentTransactionId String   @unique
  amount               Decimal
  status               String
  createdAt            DateTime @default(now())

  order  Order   @relation(fields: [orderId], references: [id])
  seller Company @relation(fields: [sellerId], references: [id])

  @@index([orderId])
  @@index([sellerId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([type])
  @@index([isRead])
  @@index([createdAt])
}

model Review {
  id        String   @id @default(cuid())
  orderId   String   @unique
  buyerId   String
  sellerId  String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  order  Order   @relation("OrderReview", fields: [orderId], references: [id])
  buyer  Company @relation("BuyerReviews", fields: [buyerId], references: [id])
  seller Company @relation("SellerReviews", fields: [sellerId], references: [id])

  @@index([sellerId])
  @@index([buyerId])
}

model ChatThread {
  id              String         @id @default(cuid())
  type            ChatThreadType
  rfqId           String?
  orderId         String?
  shippingOrderId String?        @unique
  buyerId         String
  sellerId        String
  logisticsId     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  buyer         Company        @relation("BuyerChatThreads", fields: [buyerId], references: [id])
  seller        Company        @relation("SellerChatThreads", fields: [sellerId], references: [id])
  logistics     Company?       @relation("LogisticsChatThreads", fields: [logisticsId], references: [id])
  rfq           RFQ?           @relation(fields: [rfqId], references: [id])
  order         Order?         @relation(fields: [orderId], references: [id])
  shippingOrder ShippingOrder? @relation(fields: [shippingOrderId], references: [id])
  messages      ChatMessage[]

  @@unique([rfqId, buyerId, sellerId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([logisticsId])
  @@index([rfqId])
  @@index([orderId])
  @@index([shippingOrderId])
}

model ChatMessage {
  id        String  @id @default(cuid())
  threadId  String
  senderId  String
  content   String
  isFlagged Boolean @default(false)

  fileUrl  String?
  fileName String?
  fileType String?

  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  thread ChatThread @relation(fields: [threadId], references: [id])
  sender User       @relation(fields: [senderId], references: [id])

  @@index([threadId])
  @@index([senderId])
  @@index([createdAt])
}

model PayoutRequest {
  id          String              @id @default(cuid())
  companyId   String
  amount      Decimal
  iban        String
  status      PayoutRequestStatus @default(PENDING)
  adminNote   String?
  createdAt   DateTime            @default(now())
  processedAt DateTime?

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([status])
}
